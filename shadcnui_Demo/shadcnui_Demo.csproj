            <HintPath>$(ReferencePath)BepInEx.dll</HintPath>
        </Reference>
        <Reference Include="MelonLoader" Condition=" '$(Configuration)' == 'IL2CPP_MELONLOADER_PRE57' Or '$(Configuration)' == 'IL2CPP_MELONLOADER' Or '$(Configuration)' == 'Mono_Melonloader' ">
            <HintPath>$(ReferencePath)MelonLoader.dll</HintPath>
        </Reference>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(ReferencePath)Assembly-CSharp.dll</HintPath>
        </Reference>
    </ItemGroup>
    <Choose>
        <When Condition=" '$(Configuration)' == 'IL2CPP_MELONLOADER_PRE57' ">
            <ItemGroup>
                <Reference Include="UnhollowerBaseLib">
                    <HintPath>$(ReferencePath)UnhollowerBaseLib.dll</HintPath>
                </Reference>
                <Reference Include="UnhollowerRuntimeLib">
                    <HintPath>$(ReferencePath)UnhollowerRuntimeLib.dll</HintPath>
                </Reference>
                <Reference Include="Il2Cppmscorlib">
                    <HintPath>$(ReferencePath)Il2Cppmscorlib.dll</HintPath>
                </Reference>
            </ItemGroup>
        </When>
        <When Condition=" '$(Configuration)' == 'IL2CPP_MELONLOADER' ">
            <ItemGroup>
                <Reference Include="Il2CppInterop.Runtime">
                    <HintPath>$(ReferencePath)Il2CppInterop.Runtime.dll</HintPath>
                </Reference>
                <Reference Include="Il2Cppmscorlib">
                    <HintPath>$(ReferencePath)Il2Cppmscorlib.dll</HintPath>
                </Reference>
            </ItemGroup>
        </When>
        <When Condition=" '$(Configuration)' == 'IL2CPP_BEPINEX' ">
            <ItemGroup>
                <Reference Include="UnhollowerBaseLib">
                    <HintPath>$(ReferencePath)UnhollowerBaseLib.dll</HintPath>
                </Reference>
                <Reference Include="UnhollowerRuntimeLib">
                    <HintPath>$(ReferencePath)UnhollowerRuntimeLib.dll</HintPath>
                </Reference>
                <Reference Include="Il2Cppmscorlib">
                    <HintPath>$(ReferencePath)Il2Cppmscorlib.dll</HintPath>
                </Reference>
            </ItemGroup>
        </When>
    </Choose>
    <ItemGroup Condition=" '$(Configuration)' == 'IL2CPP_BepInEx' ">
        <Reference Include="BepInEx.Core">
            <HintPath>$(ReferencePath)\BepInEx.Core.dll</HintPath>
        </Reference>
        <Reference Include="BepInEx.Preloader.Core">
            <HintPath>$(ReferencePath)\BepInEx.Preloader.Core.dll</HintPath>
        </Reference>
        <Reference Include="BepInEx.Unity.Common">
            <HintPath>$(ReferencePath)\BepInEx.Unity.Common.dll</HintPath>
        </Reference>
        <Reference Include="BepInEx.Unity.IL2CPP">
            <HintPath>$(ReferencePath)\BepInEx.Unity.IL2CPP.dll</HintPath>
        </Reference>
        <Reference Include="Il2CppInterop.Common">
